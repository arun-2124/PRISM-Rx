# PRISM-Rx Environment Variables Template
# Copy to .env for local overrides (DO NOT COMMIT SECRETS)

# Backend Server Configuration
PORT=8000
PRISM_FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Copilot AI Configuration (Optional server-side key)
PRISM_AI_PROVIDER=deterministic
PRISM_AI_API_KEY=

# Frontend Configuration (Supplied during Vite build)
VITE_API_BASE=http://localhost:8000/api
